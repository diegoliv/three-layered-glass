{
  "name": "three-layered-glass",
  "version": "1.0.0",
  "description": "Layer-aware glass for Three.js and React Three Fiber using real static mesh geometry and automatic opaque intersections.",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./advanced": {
      "types": "./src/advanced.d.ts",
      "import": "./src/advanced.js",
      "default": "./src/advanced.js"
    },
    "./legacy": {
      "types": "./src/legacy.d.ts",
      "import": "./src/legacy.js",
      "default": "./src/legacy.js"
    },
    "./postprocessing": {
      "types": "./src/postprocessing.d.ts",
      "import": "./src/postprocessing.js",
      "default": "./src/postprocessing.js"
    },
    "./r3f": {
      "types": "./src/r3f/index.d.ts",
      "import": "./src/r3f/index.js",
      "default": "./src/r3f/index.js"
    },
    "./r3f/advanced": {
      "types": "./src/r3f/advanced.d.ts",
      "import": "./src/r3f/advanced.js",
      "default": "./src/r3f/advanced.js"
    },
    "./r3f/legacy": {
      "types": "./src/r3f/legacy.d.ts",
      "import": "./src/r3f/legacy.js",
      "default": "./src/r3f/legacy.js"
    },
    "./r3f/postprocessing": {
      "types": "./src/r3f/postprocessing.d.ts",
      "import": "./src/r3f/postprocessing.js",
      "default": "./src/r3f/postprocessing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:demo": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc -p test/tsconfig.json",
    "prepublishOnly": "npm run check && npm run typecheck && npm test"
  },
  "keywords": [
    "three",
    "threejs",
    "webgl2",
    "glass",
    "refraction",
    "transmission",
    "shader",
    "react-three-fiber",
    "r3f",
    "postprocessing",
    "ray-tracing",
    "ray-traversal",
    "order-independent-transparency",
    "bvh",
    "gltf",
    "glb",
    "buffergeometry",
    "automatic-opaque-intersections"
  ],
  "author": "Diego de Oliveira",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoliv/three-layered-glass.git"
  },
  "bugs": {
    "url": "https://github.com/diegoliv/three-layered-glass/issues"
  },
  "homepage": "https://diegoliv.github.io/three-layered-glass/",
  "peerDependencies": {
    "@react-three/fiber": ">=8 <10",
    "react": ">=18 <20",
    "three": ">=0.163.0 <1"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/test-renderer": "^9.1.0",
    "@types/react": "^19.2.0",
    "@types/three": "^0.185.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "dependencies": {
    "three-mesh-bvh": "^0.9.13"
  }
}
